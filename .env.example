# ============================================
# MONGODB CONFIGURATION
# ============================================
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/chatapp

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=your_super_secret_key_here_min_32_characters_for_security

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# FIREBASE CONFIGURATION
# ============================================
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ============================================
# EMAIL CONFIGURATION (BREVO)
# ============================================
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_USER=noreply@chatapp.com

# ============================================
# URL CONFIGURATION
# ============================================
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
RENDER_EXTERNAL_URL=https://your-deployed-backend.onrender.com

# ============================================
# OPTIONAL FEATURES
# ============================================
ENABLE_NOTIFICATIONS=true
LOG_LEVEL=debug
